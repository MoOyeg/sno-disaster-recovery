<mxfile host="app.diagrams.net" modified="2026-01-08T00:00:00.000Z" agent="5.0" version="22.1.0" etag="draw.io" type="device">
  <diagram name="Failback Sequence" id="failback">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Failback Sequence: Restore Normal Operations&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- Current State Box -->
        <mxCell id="current-state" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1040" height="120" as="geometry" />
        </mxCell>
        <mxCell id="current-title" value="&lt;b&gt;Current State: After Failover&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="90" width="250" height="25" as="geometry" />
        </mxCell>
        
        <!-- Two columns for current state -->
        <mxCell id="current-active" value="&lt;b&gt;sno-cluster2 (active):&lt;/b&gt;&#xa;• app-role: active&#xa;• Quarkus app running&#xa;• MySQL with current data&#xa;• ReplicationSource → sno-cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="125" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="current-standby" value="&lt;b&gt;sno-cluster (standby):&lt;/b&gt;&#xa;• app-role: standby&#xa;• No application&#xa;• MySQL PVC updated every 2min&#xa;• ReplicationDestination ← from sno-cluster2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="125" width="500" height="65" as="geometry" />
        </mxCell>
        
        <!-- Step 1: Wait for Sync -->
        <mxCell id="step1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="1040" height="100" as="geometry" />
        </mxCell>
        <mxCell id="step1-title" value="&lt;b&gt;Step 1: Wait for Data Synchronization&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="350" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step1-desc" value="&lt;b&gt;Action:&lt;/b&gt; Wait for sufficient replication cycles to complete&#xa;&lt;b&gt;Why:&lt;/b&gt; Ensure sno-cluster has latest data before switching back&#xa;&lt;b&gt;Time:&lt;/b&gt; Wait at least 2-3 replication cycles (10-15 minutes for schedule: */5 * * * *)&#xa;&lt;b&gt;Verify:&lt;/b&gt; Check ReplicationSource status on sno-cluster2 and ReplicationDestination status on sno-cluster" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="280" width="1000" height="50" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="600" y="350" as="sourcePoint" />
            <mxPoint x="600" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- Step 2: Label Change -->
        <mxCell id="step2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="1040" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step2-title" value="&lt;b&gt;Step 2: Switch Labels Back to Original State&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step2-cmd" value="oc label managedcluster sno-cluster app-role=active --overwrite&#xa;oc label managedcluster sno-cluster2 app-role=standby --overwrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="435" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step2-desc" value="&lt;b&gt;Result:&lt;/b&gt; This single command triggers the entire failback automation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="1000" height="20" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="600" y="520" as="sourcePoint" />
            <mxPoint x="600" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- Step 3: Automatic Actions -->
        <mxCell id="step3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="1040" height="200" as="geometry" />
        </mxCell>
        <mxCell id="step3-title" value="&lt;b&gt;Step 3: Automatic Policy Actions (Parallel Execution)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="450" height="25" as="geometry" />
        </mxCell>
        
        <!-- Three sections: ArgoCD, VolSync Active, VolSync Standby -->
        <mxCell id="step3-argocd" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="605" width="320" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step3-argocd-title" value="&lt;b&gt;ArgoCD Actions&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="615" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step3-argocd-desc" value="1. Detects placement change&#xa;2. Deletes Application from&#xa;   sno-cluster2&#xa;3. Creates Application on&#xa;   sno-cluster&#xa;4. Deploys Quarkus + MySQL&#xa;5. App connects to existing&#xa;   PVC with synced data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="640" width="300" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-active" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="605" width="320" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step3-active-title" value="&lt;b&gt;VolSync: sno-cluster (active)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="615" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step3-active-desc" value="1. vs-dest-active-del:&#xa;   Remove ReplicationDestination&#xa;2. vs-source-active:&#xa;   Copy ConfigMap from hub&#xa;3. vs-source-active:&#xa;   Create ReplicationSource&#xa;4. Start replicating to&#xa;   sno-cluster2 (new standby)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="640" width="300" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="step3-standby" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="780" y="605" width="320" height="145" as="geometry" />
        </mxCell>
        <mxCell id="step3-standby-title" value="&lt;b&gt;VolSync: sno-cluster2 (standby)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="615" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step3-standby-desc" value="1. vs-source-standby-del:&#xa;   Remove ReplicationSource&#xa;2. vs-dest-standby:&#xa;   Create ReplicationDestination&#xa;3. Expose rsync-tls service&#xa;   via LoadBalancer&#xa;4. Start receiving data from&#xa;   sno-cluster (new active)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="640" width="300" height="100" as="geometry" />
        </mxCell>
        
        <!-- Arrow down -->
        <mxCell id="arrow3" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="600" y="770" as="sourcePoint" />
            <mxPoint x="600" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        
        <!-- Final State Box -->
        <mxCell id="final-state" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="1040" height="140" as="geometry" />
        </mxCell>
        <mxCell id="final-title" value="&lt;b&gt;✅ Final State: Normal Operations Restored&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="820" width="400" height="25" as="geometry" />
        </mxCell>
        
        <!-- Two columns for final state -->
        <mxCell id="final-active" value="&lt;b&gt;sno-cluster (active):&lt;/b&gt;&#xa;• app-role: active&#xa;• Quarkus app running (restored)&#xa;• MySQL with fully synced data&#xa;• ReplicationSource → sno-cluster2&#xa;• Normal operations resumed!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="855" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="final-standby" value="&lt;b&gt;sno-cluster2 (standby):&lt;/b&gt;&#xa;• app-role: standby&#xa;• No application (app removed)&#xa;• MySQL PVC being updated&#xa;• ReplicationDestination ← from sno-cluster&#xa;• Ready for next disaster!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="855" width="500" height="85" as="geometry" />
        </mxCell>
        
        <!-- Key Benefits Box -->
        <mxCell id="benefits-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="970" width="1040" height="100" as="geometry" />
        </mxCell>
        <mxCell id="benefits-title" value="&lt;b&gt;Key Benefits of Automated Failback:&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="100" y="980" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="benefits-text" value="• &lt;b&gt;Zero Configuration Required:&lt;/b&gt; All VolSync resources automatically created/deleted based on cluster role&#xa;• &lt;b&gt;No Data Loss:&lt;/b&gt; Failback only happens after sufficient replication cycles complete&#xa;• &lt;b&gt;Bidirectional DR:&lt;/b&gt; Can failover and failback repeatedly without reconfiguration&#xa;• &lt;b&gt;Symmetric Operations:&lt;/b&gt; Failover and failback use identical policy logic, just different label values&#xa;• &lt;b&gt;Production Ready:&lt;/b&gt; Same automation works for any number of SNO cluster pairs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="1010" width="1000" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
