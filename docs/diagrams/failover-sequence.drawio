<mxfile host="app.diagrams.net" modified="2026-01-08T00:00:00.000Z" agent="5.0" version="22.1.0" etag="draw.io" type="device">
  <diagram name="Failover Sequence" id="failover">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Failover Sequence: Active Cluster Failure&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- Timeline vertical line -->
        <mxCell id="timeline" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=4;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="120" y="100" as="sourcePoint" />
            <mxPoint x="120" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="timeline-label" value="&lt;b&gt;Time&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="50" y="480" width="80" height="30" as="geometry" />
        </mxCell>
        
        <!-- T=0s: Disaster -->
        <mxCell id="t0-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="105" y="100" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t0-time" value="&lt;b&gt;T=0s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t0-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t0-title" value="&lt;b&gt;⚠️ DISASTER OCCURS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t0-desc" value="• Active cluster (sno-cluster) fails completely&#xa;• Quarkus application becomes unavailable&#xa;• MySQL data is lost on failed cluster&#xa;• Last successful replication: 3 minutes ago (RPO = ~5min)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="130" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- Admin Action -->
        <mxCell id="admin-arrow" value="Administrator Action" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;fontSize=12;fontStyle=1" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="120" y="130" as="sourcePoint" />
            <mxPoint x="120" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="admin-cmd" value="oc label managedcluster sno-cluster2 app-role=active --overwrite&#xa;oc label managedcluster sno-cluster app-role=standby --overwrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="900" height="50" as="geometry" />
        </mxCell>
        
        <!-- T=5s: ACM Detection -->
        <mxCell id="t5-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="105" y="270" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t5-time" value="&lt;b&gt;T=5s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="270" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t5-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="260" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t5-title" value="&lt;b&gt;ACM Detects Label Change&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="270" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t5-desc" value="• Placement controllers detect cluster label changes&#xa;• sno-app-placement-active now selects sno-cluster2&#xa;• Policy controllers begin reconciliation&#xa;• Hub policies start updating ManagedClusterViews" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- T=15s: ArgoCD -->
        <mxCell id="t15-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="105" y="380" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t15-time" value="&lt;b&gt;T=15s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t15-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="370" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t15-title" value="&lt;b&gt;ArgoCD Detects Placement Change&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="380" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t15-desc" value="• ApplicationSet controller queries cluster list matching active placement&#xa;• Creates Application CR for sno-cluster2&#xa;• Begins deploying Quarkus + MySQL manifests to new active cluster&#xa;• MySQL PVC already exists with replicated data (no recreation needed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="410" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- T=30s: VolSync -->
        <mxCell id="t30-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="105" y="490" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t30-time" value="&lt;b&gt;T=30s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="490" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t30-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="480" width="900" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t30-title" value="&lt;b&gt;VolSync Policies Execute&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="490" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t30-desc" value="&lt;b&gt;On sno-cluster2 (new active):&lt;/b&gt;&#xa;• vs-dest-active-del: Removes ReplicationDestination (mustnothave)&#xa;• vs-source-active: Copies ConfigMap from hub via {{hub...hub}} template&#xa;• vs-source-active: Creates ReplicationSource pointing to old active (if recovered)&#xa;&lt;b&gt;On Hub:&lt;/b&gt;&#xa;• vs-source-hub-views: Updates ManagedClusterViews&#xa;• vs-dest-info-hub: Updates ConfigMap with new destination info" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="520" width="860" height="70" as="geometry" />
        </mxCell>
        
        <!-- T=45s: App Start -->
        <mxCell id="t45-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="105" y="620" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t45-time" value="&lt;b&gt;T=45s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="620" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t45-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="610" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t45-title" value="&lt;b&gt;Quarkus Pod Starts&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="620" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t45-desc" value="• Quarkus container image pulled (if not cached)&#xa;• Application starts and connects to MySQL&#xa;• Database contains data from last replication (~3-5 minutes old)&#xa;• Application begins serving traffic on sno-cluster2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="650" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- T=60s: Operational -->
        <mxCell id="t60-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="105" y="730" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t60-time" value="&lt;b&gt;T=60s&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="730" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t60-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="720" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t60-title" value="&lt;b&gt;✅ Application Fully Operational&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="730" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t60-desc" value="• LoadBalancer Service exposes application&#xa;• Health checks passing&#xa;• Traffic flows to sno-cluster2&#xa;• Zero manual configuration required - all automated by policies!" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="760" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- T=5min: First Replication -->
        <mxCell id="t5min-marker" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="105" y="840" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t5min-time" value="&lt;b&gt;T=5min&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="840" width="70" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t5min-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="830" width="900" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t5min-title" value="&lt;b&gt;First Replication from New Active&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="840" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t5min-desc" value="• ReplicationSource on sno-cluster2 triggers (schedule: */5 * * * *)&#xa;• If sno-cluster has recovered, it receives replication as new standby&#xa;• If sno-cluster is still down, replication will retry&#xa;• Data direction has fully reversed: sno-cluster2 → sno-cluster" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="870" width="860" height="50" as="geometry" />
        </mxCell>
        
        <!-- Summary Box -->
        <mxCell id="summary-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="220" y="950" width="900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="summary-title" value="&lt;b&gt;Summary:&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="960" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="summary-text" value="• &lt;b&gt;RTO (Recovery Time Objective):&lt;/b&gt; ~60 seconds (under 1 minute from label change to operational)&#xa;• &lt;b&gt;RPO (Recovery Point Objective):&lt;/b&gt; ~5 minutes (based on replication schedule)&#xa;• &lt;b&gt;Manual Steps:&lt;/b&gt; 1 command (2 label changes)&#xa;• &lt;b&gt;Automated Steps:&lt;/b&gt; 15+ resources created/deleted automatically by ACM policies" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="985" width="860" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
